{
  "name": "iquesters/user-management",
  "description": "A modular and extendable Laravel package that provides user management, role-based access control, and authentication features.",
  "keywords": [
    "laravel",
    "auth",
    "authentication",
    "users",
    "roles",
    "setup",
    "iquesters"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/iquesters/user-management",
  "support": {
    "issues": "https://github.com/iquesters/user-management/issues",
    "source": "https://github.com/iquesters/user-management",
    "security": "https://github.com/iquesters/user-management/security/policy",
    "docs": "https://github.com/iquesters/user-management/tree/main/docs"
  },
  "authors": [
    {
      "name": "Pritam Bag",
      "email": "pritam02b@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0|^13.0",
    "spatie/laravel-permission": "^8.0",
    "laravel/socialite": "^5.16",
    "laravel/sanctum": "^4.0",
    "iquesters/foundation": "^2.0",
    "iquesters/user-interface": "^2.0",
    "firebase/php-jwt": "^6.10|^7.0"
  },
  "suggest": {
    "iquesters/organisation": "Organisation menu and the create-organisation onboarding step"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "laravel/pint": "^1.18",
    "larastan/larastan": "^3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../foundation",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/foundation": "2.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../user-interface",
      "options": {
        "symlink": true,
        "versions": {
          "iquesters/user-interface": "2.x-dev"
        }
      }
    }
  ],
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "autoload": {
    "psr-4": {
      "Iquesters\\UserManagement\\": "src/",
      "Iquesters\\UserManagement\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Iquesters\\UserManagement\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Iquesters\\UserManagement\\UserManagementServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
